{
  "name": "autocare-service-scheduler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed",
    "test": "vitest run",
    "test:unit": "vitest run test/domain.test.ts",
    "test:integration": "vitest run test/integration.test.ts test/time-off.test.ts",
    "pretest:integration": "prisma generate",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "demo": "tsx scripts/demo.ts",
    "prisma:generate": "prisma generate",
    "predev": "prisma generate",
    "pretest": "prisma generate",
    "predb:migrate": "prisma generate",
    "predb:seed": "prisma generate",
    "setup:local": "sh scripts/setup-local.sh"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "@nestjs/swagger": "^12.0.4",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sinclair/typebox": "^0.34.52",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
